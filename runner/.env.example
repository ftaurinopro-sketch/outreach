REACHOS_BACKEND_URL=https://your-app.vercel.app
# Deve combaciare esattamente con RUNNER_MASTER_KEY impostata sul backend
# (Vercel → Environment Variables). Un solo processo, con questa chiave,
# serve automaticamente TUTTE le connessioni di TUTTI gli utenti — non è
# più un token per singola connessione.
RUNNER_MASTER_KEY=stessa-chiave-di-RUNNER_MASTER_KEY-su-vercel

# Metti a "false" per vedere il browser mentre lavora (utile in fase di test).
# Di default gira headless (nessuna finestra visibile).
REACHOS_HEADLESS=true

# Ogni quanti secondi ripetere il giro su tutte le connessioni.
REACHOS_POLL_INTERVAL_SECONDS=180
