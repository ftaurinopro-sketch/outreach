# Claude API — necessaria per far funzionare la Sandbox (l'agent che risponde
# al prospect di test) e il Lead Scoring AI nel Lead Finder.
ANTHROPIC_API_KEY=

# Opzionale: modello da usare (default: claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Supabase — richiesto per Auth (login/signup) e per il salvataggio
# multi-tenant dei dati. Finché ANON_KEY non è impostata, l'app resta in
# modalità locale a singolo utente (dati su file, nessun login) per lo
# sviluppo dei singoli moduli.
# Da dashboard.supabase.com → Project Settings → API:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Da Supabase Dashboard → Authentication → URL Configuration, deve
# corrispondere all'URL pubblico dell'app (es. http://localhost:3213 in
# locale, il tuo dominio Vercel in produzione) — usato per i redirect OAuth.
NEXT_PUBLIC_SITE_URL=http://localhost:3213

# Chiave di cifratura per il cookie di sessione LinkedIn e la password (se
# usi il login automatico invece di incollare il cookie a mano) salvati su
# Supabase. Richiesta solo quando Supabase è configurato — in modalità
# locale (senza ANON_KEY) questi dati restano su file, non cifrati, come il
# resto dei dati di sviluppo. Genera una chiave con:
#   openssl rand -base64 32
CONNECTION_ENCRYPTION_KEY=
