# Claude API — necessaria per far funzionare la Sandbox (l'agent che risponde
# al prospect di test). Senza questa, l'app funziona ma la Sandbox mostra un
# avviso e non può chattare.
ANTHROPIC_API_KEY=

# Opzionale: modello da usare per la Sandbox (default: claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Supabase — opzionale in locale: finché non sono impostate, gli AI Assistants
# vengono salvati in un file locale (.data/agents.json), zero setup richiesto.
# Impostale quando crei il progetto Supabase (dashboard.supabase.com) e vuoi
# passare al backend definitivo. Poi esegui supabase/migrations/0001_agents.sql.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
